# AWS credentials — passed through to `aws s3 sync`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional, for R2/MinIO/Wasabi
# AWS_ENDPOINT_URL=https://...

# Absolute path to local ComfyUI install (must contain models/ and custom_nodes/).
COMFYUI_PATH=/workspace/ComfyUI

# Base S3 prefix where the models/ layout lives.
# Final URL = ${S3_MODELS_BASE}/<folder>/<file>
S3_MODELS_BASE=s3://my-bucket/models

# Base S3 prefix for custom-node packages. Leave empty to disable node sync.
# Final URL = ${S3_NODES_BASE}/<package>/
S3_NODES_BASE=s3://my-bucket/custom_nodes

# Max concurrent `aws s3 sync` procs (default 3).
# SYNC_PARALLEL=3

# Stalled-warning threshold in seconds — emits ⚠ on a row if bytes
# do not grow for this long (default 8).
# SYNC_STALL_SECS=8
